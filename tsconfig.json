{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@evtstore/*": ["../evtstore/*", "../evtstore/src/*", "../evtstore/provider/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../evtstore/**/*"]
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./src/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@evtstore/src/*": ["./evtstore-lib/src/*", "../evtstore/src/*"],
      "@evtstore/provider/*": ["./evtstore-lib/provider/*", "../evtstore/provider/*"],
      "@evtstore/*": ["./evtstore-lib/*", "../evtstore/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/dist", "evtstore-lib"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}

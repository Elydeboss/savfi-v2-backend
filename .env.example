# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/savfi
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/savfi?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# For production:
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_NETWORK=mainnet-beta

# Company Wallet Configuration
COMPANY_WALLET_PRIVATE_KEY=your_company_wallet_private_key
COMPANY_WALLET_ADDRESS=your_company_wallet_address

# USDC Token Configuration (SPL Token)
USDC_TOKEN_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# WebSocket Configuration
WS_PORT=5001

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@savfi.com

# APY Rates (configurable by admin)
VAULTFI_APY=12
GROWFI_APY=8
FLEXIFI_APY=5
SWIFTFI_APY=2

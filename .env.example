# ============================================
# SavFi Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=production
PORT=5000

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# MongoDB connection string
# For local development:
MONGODB_URI=your_mongodb_uri_here
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/savfi?retryWrites=true&w=majority

# --------------------------------------------
# JWT Security Configuration
# --------------------------------------------
# IMPORTANT: Generate a secure secret with: openssl rand -base64 32
# Minimum 32 characters required
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_change_this
JWT_EXPIRE=7d

# --------------------------------------------
# Frontend & CORS Configuration
# --------------------------------------------
# Your frontend URL for CORS and OAuth redirects
FRONTEND_URL=https://your-frontend-domain.com
# OAuth callback URL (your backend URL)
OAUTH_CALLBACK_URL=https://your-backend-domain.com
# Optional: Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://domain1.com,https://domain2.com

# --------------------------------------------
# Google OAuth Configuration
# --------------------------------------------
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --------------------------------------------
# Apple Sign In Configuration (Optional)
# --------------------------------------------
# Get credentials from: https://developer.apple.com/
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=path_to_your_private_key_file

# --------------------------------------------
# EvtStore Event Sourcing Configuration
# --------------------------------------------
# Enable/disable event sourcing system
# Set to 'true' to enable event sourcing with EvtStore
EVTSTORE_ENABLED=false
# EvtStore uses the same MONGODB_URI for event storage

# --------------------------------------------
# Rate Limiting Configuration
# --------------------------------------------
# General API rate limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Authentication rate limiting (attempts per 15 minutes)
AUTH_RATE_LIMIT_MAX=5

# --------------------------------------------
# File Upload Configuration
# --------------------------------------------
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_LEVEL=info

# --------------------------------------------
# Solana Configuration (Future Use)
# --------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# For production:
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_NETWORK=mainnet-beta

# Company Wallet Configuration (Future Use)
COMPANY_WALLET_PRIVATE_KEY=your_company_wallet_private_key
COMPANY_WALLET_ADDRESS=your_company_wallet_address

# USDC Token Configuration (SPL Token)
USDC_TOKEN_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --------------------------------------------
# Email Configuration (Future Use)
# --------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@savfi.com

# --------------------------------------------
# WebSocket Configuration (Future Use)
# --------------------------------------------
WS_PORT=5001

# --------------------------------------------
# APY Rates (Configurable by Admin)
# --------------------------------------------
VAULTFI_APY=8
GROWFI_APY=4
FLEXIFI_APY=2
SWIFTFI_APY=0
